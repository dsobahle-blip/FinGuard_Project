{
  "datasets": [
    {
      "name": "customer_risk_summary",
      "displayName": "Customer Risk Summary",
      "config": {
        "version": "1.1",
        "source": "finguard.gold.gold_customer_risk_summary",
        "measures": [
          {
            "name": "txn_count",
            "expr": "SUM(`txn_count`)",
            "comment": "Transaction count per customer"
          },
          {
            "name": "total_amount",
            "expr": "SUM(`total_amount`)",
            "comment": "Total amount transacted"
          },
          {
            "name": "max_amount",
            "expr": "MAX(`max_amount`)",
            "comment": "Max single transaction amount"
          },
          {
            "name": "velocity_flagged_customers",
            "expr": "SUM(CAST(`is_velocity_flag` AS BIGINT))",
            "comment": "Count of velocity-flagged customers"
          }
        ],
        "dimensions": [
          {
            "name": "window_start",
            "expr": "window_start",
            "comment": "Window start timestamp"
          },
          {
            "name": "window_end",
            "expr": "window_end",
            "comment": "Window end timestamp"
          },
          {
            "name": "customer_id",
            "expr": "customer_id",
            "comment": "Customer unique ID"
          }
        ]
      }
    },
    {
      "name": "fraud_rate_summary",
      "displayName": "Fraud Rate Summary",
      "config": {
        "version": "1.1",
        "source": "finguard.gold.gold_hourly_fraud_rate",
        "measures": [
          {
            "name": "flagged_transactions",
            "expr": "SUM(`flagged_transactions`)",
            "comment": "Total flagged fraud transactions"
          },
          {
            "name": "total_transactions",
            "expr": "SUM(`total_transactions`)",
            "comment": "Total transactions"
          },
          {
            "name": "fraud_rate",
            "expr": "SUM(`flagged_transactions`) / NULLIF(SUM(`total_transactions`), 0)",
            "comment": "Fraud rate: flagged / total"
          }
        ],
        "dimensions": [
          {
            "name": "window_start",
            "expr": "window_start",
            "comment": "Window start timestamp"
          },
          {
            "name": "window_end",
            "expr": "window_end",
            "comment": "Window end timestamp"
          }
        ]
      }
    },
    {
      "name": "fraud_summary_by_merchant",
      "displayName": "Fraud Summary by Merchant",
      "config": {
        "version": "1.1",
        "source": "finguard.gold.gold_fraud_summary",
        "measures": [
          {
            "name": "flagged_count",
            "expr": "SUM(`flagged_count`)",
            "comment": "Total fraud flagged count"
          },
          {
            "name": "flagged_amount",
            "expr": "SUM(`flagged_amount`)",
            "comment": "Total fraud flagged amount"
          },
          {
            "name": "high_severity_count",
            "expr": "SUM(`high_severity_count`)",
            "comment": "High severity fraud count"
          },
          {
            "name": "medium_severity_count",
            "expr": "SUM(`medium_severity_count`)",
            "comment": "Medium severity fraud count"
          },
          {
            "name": "low_severity_count",
            "expr": "SUM(`low_severity_count`)",
            "comment": "Low severity fraud count"
          },
          {
            "name": "avg_risk_score",
            "expr": "AVG(`avg_risk_score`)",
            "comment": "Average risk score"
          }
        ],
        "dimensions": [
          {
            "name": "window_start",
            "expr": "window_start",
            "comment": "Window start timestamp"
          },
          {
            "name": "window_end",
            "expr": "window_end",
            "comment": "Window end timestamp"
          },
          {
            "name": "merchant_category",
            "expr": "merchant_category",
            "comment": "Merchant category"
          }
        ]
      }
    },
    {
      "name": "active_fraud_watchlist",
      "displayName": "Active Fraud Watchlist",
      "config": {
        "version": "1.1",
        "source": "finguard.silver.silver_fraud_watchlist",
        "measures": [
          {
            "name": "entity_count",
            "expr": "COUNT(`entity_id`)",
            "comment": "Total watchlist entities"
          },
          {
            "name": "active_count",
            "expr": "SUM(CAST(`is_active` AS BIGINT))",
            "comment": "Active flagged entities"
          }
        ],
        "dimensions": [
          {
            "name": "entity_id",
            "expr": "entity_id",
            "comment": "Entity unique ID"
          },
          {
            "name": "entity_name",
            "expr": "entity_name",
            "comment": "Entity name"
          },
          {
            "name": "entity_type",
            "expr": "entity_type",
            "comment": "Entity type"
          },
          {
            "name": "flagged_date",
            "expr": "flagged_date",
            "comment": "Date flagged"
          },
          {
            "name": "reason",
            "expr": "reason",
            "comment": "Flagging reason"
          },
          {
            "name": "severity",
            "expr": "severity",
            "comment": "Risk severity"
          },
          {
            "name": "source",
            "expr": "source",
            "comment": "Source system"
          }
        ]
      }
    }
  ],
